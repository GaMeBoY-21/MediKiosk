# Secrets and local environment files.
# The broad patterns are deliberate: a key that reaches a public repo cannot be
# un-published, and this project has already had one leak.
.env
.env.*
!.env.example
!.env.*.example
app/.demo-credentials
credentials/
**/*credentials*
**/*secret*
**/*api_key*
**/*apikey*
*.pem
*.key
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript / Vite / Node
node_modules/
dist/
build/
target/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data and generated application artifacts
*.db
# local db side files (WAL mode)
*.db-shm
*.db-wal
uploads/
logs/
*.log
tmp/
temp/
.cache/
coverage/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific files
.DS_Store
.AppleDouble
.LSOverride
._*
Icon
ehthumbs.db
Thumbs.db
