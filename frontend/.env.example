# Owner: Ranjith
# Copy to .env.local to override. Do not commit a real .env.

# Serve every API call from /mocks/sample_session.json with a 300ms delay.
# Mocks are ON unless this is explicitly "false", so the flow is walkable
# before app/ exists.
VITE_USE_MOCKS=true

# Only used when VITE_USE_MOCKS=false.
VITE_API_BASE=http://localhost:8000
