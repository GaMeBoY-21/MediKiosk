# Owner: Ranjith
# Copy to .env.local to override. Do not commit a real .env.

# Serve every API call from /mocks/sample_session.json with a 300ms delay.
# Defaults to FALSE: the real backend is built, and leaving mocks on hid every
# bit of it — a session that never called app/ looked identical to one that
# did. Set this to "true" only to walk the UI with the backend stopped.
VITE_USE_MOCKS=false

# Base URL for the API, used when VITE_USE_MOCKS is not "true".
# MUST include the /api suffix: app/main.py mounts every router under
# API_PREFIX="/api", while client.js requests bare paths like
# "/session/start". Without it every call 404s.
VITE_API_BASE=http://localhost:8000/api

# Serve a real recorded session from public/replay/session.json instead of
# calling the API at all. No network, no Gemini quota, identical behaviour.
# Insurance for the demo: the free tier has a hard daily cap and venue wifi
# fails. A persistent red REPLAY badge shows whenever this is on, so a
# recording can never be presented as a live run.
# Re-record with: python3 scripts/record_replay.py (backend must be running)
VITE_REPLAY=false
