# Copy to .env and fill in. Never commit .env.

# Read from app/.env or this repo-root .env — app/.env wins. Both paths are
# resolved relative to app/config.py, so it does not matter where you start
# uvicorn from.

# Key for the AI layer (ai/). Extraction, follow-ups, the summary and the
# red-flag path are all live now, so an unset key fails loudly on first use
# naming this variable — it no longer degrades to canned responses.
#
# Still works on its own, and is used as key 1 when the numbered keys below
# are all blank. Filling in GEMINI_API_KEY_1 takes precedence over this.
GEMINI_API_KEY=

# ---------------------------------------------------------------- key pool
#
# EACH KEY MUST COME FROM A DIFFERENT GOOGLE ACCOUNT.
#
# The free-tier quota is metered per Google Cloud PROJECT, not per key. Five
# keys generated from one account draw on ONE allowance, so the pool would
# report five pools and run out at the same moment as one. Five accounts give
# five genuinely independent allowances.
#
# Blank slots are skipped silently: filling three of the five is fine, and the
# pool is then three keys, not five. Duplicate values are counted once.
#
# Combined with GEMINI_MODEL_FALLBACK below, five keys and two models make ten
# independent daily pools. Failover order is every key on the primary model,
# then every key on the fallback.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Gemini model id. REQUIRED — deliberately has no default, because Google
# retires model names without notice and a stale default took the whole app
# down with 404s (gemini-1.5-flash, gemini-2.5-flash are both gone).
# gemini-3.5-flash-lite: ~1-1.5s per call and a far larger free-tier daily
# quota than the full Flash models, which are limited to 20 requests/day.
GEMINI_MODEL=gemini-3.5-flash-lite

# A SECOND model id, optional. Quota is metered per model as well as per
# project, so naming a different model here doubles every key's allowance.
# It is also where the pool goes when the primary is OVERLOADED — Google
# answers a busy model with 503, which is now a fail-over rather than an
# error, so this needs to be a model that actually exists.
#
# Check it is still live before a demo: Google retires names without notice.
# gemini-2.0-flash was the value here and had already been retired, which left
# half the pool pointing at a 404. Verified answering: gemini-3.5-flash (7.0s)
# and gemini-3.6-flash (2.5s).
GEMINI_MODEL_FALLBACK=gemini-3.5-flash

# Postgres DSN, e.g. postgresql+psycopg2://user:pass@localhost:5432/medikiosk
# Leave blank to use the local SQLite fallback (./medikiosk.db) so the demo
# runs without Postgres. Blank is refused when APP_ENV=production.
DATABASE_URL=

# development | production
APP_ENV=development

# --- optional, sensible defaults already applied in app/config.py ---

# Origins allowed to call the API. JSON list. Defaults to the Vite and CRA
# dev servers.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# How long an abandoned session lingers in memory before it is purged.
# SESSION_TTL_SECONDS=3600

# --- clinician console auth (app/.env) ---
# Signing key for clinician tokens. REQUIRED, no default: a predictable key
# lets anyone mint a doctor token and read every patient in the queue.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# The one seeded demo account. Hashed with bcrypt at startup; the plaintext is
# never stored, logged or returned in any payload.
CLINICIAN_USERNAME=
CLINICIAN_PASSWORD=
CLINICIAN_NAME=
# doctor | triage | admin
CLINICIAN_ROLE=doctor
